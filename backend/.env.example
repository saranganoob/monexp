# Copy this file to .env and fill in the values. Never commit .env.

PORT=3000
MONGODB_URI=mongodb://localhost:27017/monexp

# Signs your login session. Any long random text (32+ characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Claude API key for the AI assistant and monthly summary (console.anthropic.com → API Keys).
# Paste your own key here; it stays on this machine and is never sent to the browser.
ANTHROPIC_API_KEY=

# Which Claude model to use. Default: claude-opus-5-5.
# For lower cost, use claude-sonnet-5-5.
ANTHROPIC_MODEL=

# Demo OTP sign-in (no SMS/email is sent). Set a fixed 6-digit code, e.g. 123456,
# to allow "Sign in with OTP". Leave empty to turn OTP sign-in off.
DEV_OTP=
