# Copy this file to .env and fill in the values. Never commit .env.

PORT=3000
MONGODB_URI=mongodb://localhost:27017/monexp

# Signs your login session. Any long random text (32+ characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Claude API key – only needed from Phase 4 (AI features). Paste your own key here.
ANTHROPIC_API_KEY=
