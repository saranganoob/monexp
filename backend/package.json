{
  "name": "monexp-backend",
  "version": "0.1.0",
  "private": true,
  "description": "MonEXP API – Express + MongoDB",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "create-user": "node --env-file-if-exists=.env scripts/create-user.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "restore": "node --env-file-if-exists=.env scripts/restore.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
